# PUSKRIS ALL - Environment Configuration

# URL Backend API (misal backend Rust / Go / Python / Node)
BACKEND_INTERNAL_URL=http://localhost:8091

# Base Path Next.js (kosongkan jika dijalankan di root http://localhost:3000)
NEXT_PUBLIC_BASE_PATH=

# Default Locale (id atau en)
NEXT_PUBLIC_DEFAULT_LOCALE=id

# Bypass Auth: set true untuk mode preview tampilan statis / frontend tanpa butuh database/login
NEXT_PUBLIC_BYPASS_AUTH=true

# Nama cookie session
SESSION_COOKIE_NAME=puskris_session


# Token API resmi Pusat Krisis Kesehatan (PSC 119, Asistensi). HANYA di server — jangan diberi awalan NEXT_PUBLIC_.
# Isi di .env.local (lokal) dan di Vercel → Project Settings → Environment Variables. Bila kosong, dasbor memakai snapshot.
PUSKRIS_TTOKEN=
# Opsional: ganti alamat dasar API bila berubah
# PUSKRIS_PSC_BASE=https://psc.kemkes.go.id
# PUSKRIS_ASISTENSI_BASE=https://pusatkrisis.kemkes.go.id/asistensi
