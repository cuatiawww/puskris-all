# =============================================================================
# Dashboard Puskris - Environment Configuration Example
# Salin file ini menjadi `.env` lalu isi nilai rahasia sebelum menjalankan Docker:
#   cp .env.example .env
# JANGAN PERNAH commit file `.env` ke git atau menyalinnya ke dalam Docker image.
# =============================================================================

# --- Konfigurasi Publik Next.js (Non-Secret, dipakai saat build & runtime) ---
NEXT_PUBLIC_BYPASS_AUTH=true
NEXT_PUBLIC_BASE_PATH=/dashboard
NEXT_PUBLIC_DEFAULT_LOCALE=id
NEXT_TELEMETRY_DISABLED=1

# --- Kredensial & Endpoint API Resmi Puskris (HANYA Runtime / Server-Side) ---
PUSKRIS_TTOKEN=
PUSKRIS_EOC_AUTH=
PUSKRIS_NCC_URL=
PUSKRIS_NCC_KEY=
PUSKRIS_NCC_SHEET_URL=

# --- Opsional (Docker host port) ---
# APP_PORT=3000
